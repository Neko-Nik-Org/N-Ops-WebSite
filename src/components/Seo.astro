---
interface Props {
  title: string;
  description: string;
  path?: string;
  /** keep the page out of search results (404 etc.) */
  noindex?: boolean;
}

const { title, description, path = "/", noindex = false } = Astro.props;

const canonicalURL = new URL(path, Astro.site);
// one share card for the whole site, 1200×630 (public/og.png)
const ogImage = new URL("/og.png", Astro.site);
const ogAlt = "N-Ops: One platform. Complete infrastructure control.";
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
{!noindex && <link rel="canonical" href={canonicalURL} />}

<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content="N-Ops" />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />
