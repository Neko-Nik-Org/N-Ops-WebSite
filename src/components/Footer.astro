---
const year = new Date().getFullYear();
---
<footer class="relative z-[1] pt-[clamp(48px,6vw,80px)] pb-9 border-t border-line bg-surface">
  <div class="wrap ft grid grid-cols-4 bp3:grid-cols-12 gap-x-[var(--gut)] gap-y-10">
    <div class="ft-brand col-span-4 bp3:col-span-12 bp2:col-span-4">
      <span class="brand wm-ink inline-flex items-center gap-[11px] font-bold text-[22px] tracking-[-.035em]"><svg aria-hidden="true" class="w-[34px] h-[34px] flex-none"><use href="#fpLogo"/></svg><span>N<span class="hy text-mint-ink">-</span>Ops</span></span>
      <p class="text-ink-2 text-[15px] mt-4 max-w-[34ch]">The open-source infrastructure control plane. Servers, secrets, containers, jobs and audit, in one place.</p>
    </div>
    <nav class="ft-col col-span-2 bp3:col-span-4 bp2:col-span-2 bp2:col-start-7" aria-label="Product">
      <h4 class="font-mono text-[11.5px] tracking-[.1em] uppercase text-mute mb-4">Product</h4>
      <ul><li class="my-[9px] text-[15px]"><a href="/#chapters" class="hover:text-mint-ink">Features</a></li><li class="my-[9px] text-[15px]"><a href="/#architecture" class="hover:text-mint-ink">Architecture</a></li><li class="my-[9px] text-[15px]"><a href="/#security" class="hover:text-mint-ink">Security</a></li><li class="my-[9px] text-[15px]"><a href="/pricing" class="hover:text-mint-ink">Pricing</a></li></ul>
    </nav>
    <nav class="ft-col col-span-2 bp3:col-span-4 bp2:col-span-2" aria-label="Resources">
      <h4 class="font-mono text-[11.5px] tracking-[.1em] uppercase text-mute mb-4">Resources</h4>
      <ul><li class="my-[9px] text-[15px]"><a href="https://nops.app" rel="noopener" class="hover:text-mint-ink">Docs</a></li><li class="my-[9px] text-[15px]"><a href="/faq" class="hover:text-mint-ink">FAQ</a></li><li class="my-[9px] text-[15px]"><a href="https://github.com/Neko-Nik-Org/N-Ops-Main-API/releases" rel="noopener" class="hover:text-mint-ink">Releases</a></li></ul>
    </nav>
    <nav class="ft-col col-span-2 bp3:col-span-4 bp2:col-span-2" aria-label="Community">
      <h4 class="font-mono text-[11.5px] tracking-[.1em] uppercase text-mute mb-4">Community</h4>
      <ul><li class="my-[9px] text-[15px]"><a href="https://github.com/Neko-Nik-Org/N-Ops-Main-API" rel="noopener" class="hover:text-mint-ink">GitHub</a></li><li class="my-[9px] text-[15px]"><a href="https://nekonik.org" rel="noopener" class="hover:text-mint-ink">nekonik.org</a></li><li class="my-[9px] text-[15px]"><a href="https://yukthi.com" rel="noopener" class="hover:text-mint-ink">YSPL</a></li></ul>
    </nav>
    <p class="ft-giant col-span-4 bp3:col-span-12 whitespace-nowrap font-bold tracking-[-.07em] leading-[.78] mt-5 -mb-1.5 text-ink select-none overflow-hidden pb-[.04em] text-[clamp(3.5rem,33vw,31rem)]" aria-hidden="true">N<span class="hy text-mint">-</span>Ops</p>
    <div class="ft-bot col-span-4 bp3:col-span-12 flex flex-wrap gap-x-7 gap-y-3 justify-between border-t border-line pt-[22px] font-mono text-xs leading-normal text-mute">
      <span>Built by <b class="text-ink font-semibold">Neko Nik</b> in partnership with <b class="text-ink font-semibold">YSPL</b></span>
      <span>GNU GPL-V3.0 licence, © {year}</span>
      <span>N-Ops is in active development</span>
    </div>
  </div>
</footer>
