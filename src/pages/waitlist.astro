---
import BaseLayout from "../layouts/BaseLayout.astro";

const key = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const f = "mt-1.5 w-full rounded-xl border border-line-2 bg-transparent px-4 py-3 text-[16px] focus:outline-2 focus:outline-mint";
const l = "block font-mono text-[10.5px] tracking-[.14em] uppercase text-mute";
const o = "flex items-start gap-2.5 rounded-xl border border-line-2 bg-transparent px-3.5 py-2.5 text-[14.5px] leading-snug cursor-pointer has-[:checked]:border-mint-ink has-[:checked]:bg-mint/10";
const og = "mt-1.5 grid grid-cols-1 gap-2";

const roleOpts = ["Developer", "DevOps or SRE", "Sysadmin", "Engineering lead or CTO", "Founder", "Student or hobbyist"];
const serverOpts = ["1–5", "6–20", "21–100", "101–500", "500+"];
const teamOpts = ["Just me", "2–5", "6–20", "21–50", "50+"];
const toolOpts = ["SSH and scripts", "Ansible", "Portainer", "HashiCorp Vault or another secret manager", "Grafana or Prometheus", "Rundeck", "Cloud provider console", "Nothing in particular"];
const featureOpts = ["Vault", "Server access rules and SSH", "Tools (commands on many servers)", "Docker and Podman", "Approvals", "Workflows", "Metrics and alerts", "Audit logs", "PostgreSQL management"];
const runOpts = ["Self-host it for free", "Have you host it (managed)", "Not sure yet"];
const payOpts = ["Yes", "Maybe, depending on price", "No, we'd self-host"];
const priceOpts = ["Under $25", "$25–50", "$50–100", "$100–250", "$250–500", "$500–1,000", "$1,000+"];
const priceOptsINR = ["Under ₹2,000", "₹2,000–4,000", "₹4,000–8,000", "₹8,000–20,000", "₹20,000–40,000", "₹40,000–80,000", "₹80,000+"];
const payPrefOpts = ["Per server", "Per user", "One flat monthly price", "Yearly contract"];
const buyerOpts = ["I do", "I recommend, someone else approves", "I'm not involved"];
const spendOpts = ["Nothing", "Under $50", "$50–200", "$200–1,000", "$1,000+"];
const spendOptsINR = ["Nothing", "Under ₹4,000", "₹4,000–15,000", "₹15,000–80,000", "₹80,000+"];
const contactOpts = ["Yes", "No"];

const steps = ["About you", "Your setup", "Tools & features", "Will you pay", "Wrap-up"];
---
<BaseLayout title="Join the waitlist — N-Ops" description="Get early access to N-Ops Managed Cloud. Takes under 2 minutes." path="/waitlist">
<section class="pt-[clamp(32px,5vw,72px)] pb-[clamp(64px,9vw,140px)]" aria-labelledby="wl-h">
  <div class="wrap">
    <div class="max-w-[640px] mx-auto">
      <p class="eyebrow"><span class="bar"></span>N-Ops Managed Cloud</p>
      <h1 id="wl-h" class="mt-5 text-[clamp(2rem,4vw,3rem)] leading-[1] tracking-[-.045em]">Join the waitlist</h1>
      <p class="mt-3 text-mute text-[15px]">Tell us about your setup — takes under 2 minutes.</p>

      <div class="mt-8 rounded-[22px] border border-line-2 bg-surface p-[clamp(22px,2.6vw,36px)]">
        <div class="flex items-center justify-between font-mono text-[11px] tracking-[.1em] uppercase text-mute">
          <span data-step-label>Step 1 of {steps.length} — {steps[0]}</span>
          <span data-step-count>1/{steps.length}</span>
        </div>
        <div class="mt-3 h-1 rounded-full bg-line-2 overflow-hidden"><div data-progress class="h-full bg-mint transition-[width] duration-300" style="width:25%"></div></div>

        <form id="waitlist-form" class="mt-6 grid gap-4" data-url={import.meta.env.PUBLIC_FORMS_URL} data-to={import.meta.env.PUBLIC_FORMS_SEND_TO} novalidate>

          <div data-step="1" class="grid gap-4">
            <label class={l}>Email <span class="normal-case text-mint-ink">*</span><input class={f} name="email" type="email" required maxlength="150" autocomplete="email" /></label>
            <label class={l}>Name<input class={f} name="name" maxlength="100" autocomplete="name" /></label>
            <label class={l}>Company<input class={f} name="company" maxlength="100" autocomplete="organization" /></label>
            <div>
              <p class={l}>What best describes you?</p>
              <div class={og} data-options>
                {roleOpts.map((opt) => <label class={o}><input type="radio" name="role" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}
                <label class={o}><input type="radio" name="role" value="Other" class="mt-0.5 accent-mint-ink shrink-0" data-other-toggle="roleOther" />Other</label>
              </div>
              <input class={f} name="roleOther" placeholder="Tell us" maxlength="100" hidden />
            </div>
          </div>

          <div data-step="2" class="grid gap-4" hidden>
            <div><p class={l}>How many servers do you manage?</p><div class={og} data-options>{serverOpts.map((opt) => <label class={o}><input type="radio" name="servers" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
            <div><p class={l}>How many people on your team would use N-Ops?</p><div class={og} data-options>{teamOpts.map((opt) => <label class={o}><input type="radio" name="teamSize" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
          </div>

          <div data-step="3" class="grid gap-4" hidden>
            <div>
              <p class={l}>What do you use today? <span class="normal-case text-mute">(pick any)</span></p>
              <div class={og} data-options>
                {toolOpts.map((opt) => <label class={o}><input type="checkbox" name="tools" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}
                <label class={o}><input type="checkbox" name="tools" value="Other" class="mt-0.5 accent-mint-ink shrink-0" data-other-toggle="toolsOther" />Other</label>
              </div>
              <input class={f} name="toolsOther" placeholder="Tell us" maxlength="100" hidden />
            </div>
            <div>
              <p class={l}>Which features matter most to you? <span class="normal-case text-mute">(pick up to 3)</span></p>
              <div class={og} data-options data-max-select="3">{featureOpts.map((opt) => <label class={o}><input type="checkbox" name="features" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
            </div>
          </div>

          <div data-step="4" class="grid gap-4" hidden>
            <div><p class={l}>Currency for the price questions below</p><div class={og + " grid-cols-2"} data-options id="currency-group"><label class={o}><input type="radio" name="currency" value="USD" checked class="mt-0.5 accent-mint-ink shrink-0" />USD</label><label class={o}><input type="radio" name="currency" value="INR" class="mt-0.5 accent-mint-ink shrink-0" />INR</label></div></div>
            <div><p class={l}>How would you run N-Ops?</p><div class={og} data-options>{runOpts.map((opt) => <label class={o}><input type="radio" name="howRun" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
            <div><p class={l}>Would your team pay for N-Ops Managed, hosted by us with SLAs and phone support?</p><div class={og} data-options id="wouldpay-group">{payOpts.map((opt) => <label class={o}><input type="radio" name="wouldPay" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
            <div id="pricing-extra" class="grid gap-4" hidden>
              <div>
                <p class={l}>What monthly price would feel fair for your whole team?</p>
                <div class={og} data-options data-currency="USD">{priceOpts.map((opt) => <label class={o}><input type="radio" name="fairPrice" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
                <div class={og} data-options data-currency="INR" hidden>{priceOptsINR.map((opt) => <label class={o}><input type="radio" name="fairPrice" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
              </div>
              <div>
                <p class={l}>At what monthly price would it be too expensive to consider?</p>
                <div class={og} data-options data-currency="USD">{priceOpts.map((opt) => <label class={o}><input type="radio" name="tooExpensive" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
                <div class={og} data-options data-currency="INR" hidden>{priceOptsINR.map((opt) => <label class={o}><input type="radio" name="tooExpensive" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
              </div>
              <div><p class={l}>How would you prefer to pay?</p><div class={og} data-options>{payPrefOpts.map((opt) => <label class={o}><input type="radio" name="payPreference" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
              <div><p class={l}>Who decides on buying tools like this?</p><div class={og} data-options>{buyerOpts.map((opt) => <label class={o}><input type="radio" name="buyerRole" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
            </div>
          </div>

          <div data-step="5" class="grid gap-4" hidden>
            <div>
              <p class={l}>What do you spend each month today on the tools N-Ops would replace?</p>
              <div class={og} data-options data-currency="USD">{spendOpts.map((opt) => <label class={o}><input type="radio" name="currentSpend" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
              <div class={og} data-options data-currency="INR" hidden>{spendOptsINR.map((opt) => <label class={o}><input type="radio" name="currentSpend" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div>
            </div>
            <label class={l}>What's the one problem you'd want N-Ops to solve first?<textarea class={f} name="topProblem" rows="3" maxlength="1000"></textarea></label>
            <div><p class={l}>Can we contact you for a 15-minute call?</p><div class={og} data-options>{contactOpts.map((opt) => <label class={o}><input type="radio" name="canContact" value={opt} class="mt-0.5 accent-mint-ink shrink-0" />{opt}</label>)}</div></div>
            {key && <div class="cf-turnstile" data-sitekey={key}></div>}
          </div>

          <div class="flex flex-wrap items-center gap-3 pt-2">
            <button type="button" data-back class="btn btn-line" hidden>Back</button>
            <button type="button" data-next class="btn btn-mint">Next</button>
            <button type="submit" data-submit class="btn btn-mint" hidden>Join waitlist</button>
            <p class="text-[14px] text-mute" role="status" aria-live="polite" data-status></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
</BaseLayout>
<script define:vars={{ steps }}>
  const siteTheme = () => (document.documentElement.getAttribute("data-theme") === "dark" ? "dark" : "light");
  document.querySelectorAll(".cf-turnstile").forEach((el) => (el.dataset.theme = siteTheme()));
  new MutationObserver(() => {
    const ts = window.turnstile;
    document.querySelectorAll(".cf-turnstile").forEach((el) => {
      ts?.remove(el);
      ts?.render(el, { sitekey: el.dataset.sitekey, theme: siteTheme() });
    });
  }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  if (document.querySelector(".cf-turnstile")) {
    const s = document.createElement("script");
    s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js"; s.async = true;
    document.head.append(s);
  }

  const form = document.getElementById("waitlist-form");
  const stepEls = Array.from(form.querySelectorAll("[data-step]"));
  const backBtn = form.querySelector("[data-back]");
  const nextBtn = form.querySelector("[data-next]");
  const submitBtn = form.querySelector("[data-submit]");
  const stepLabel = document.querySelector("[data-step-label]");
  const stepCount = document.querySelector("[data-step-count]");
  const progress = document.querySelector("[data-progress]");
  const status = form.querySelector("[data-status]");
  let current = 1;

  function showStep(n) {
    current = n;
    stepEls.forEach((el) => (el.hidden = Number(el.dataset.step) !== n));
    backBtn.hidden = n === 1;
    nextBtn.hidden = n === steps.length;
    submitBtn.hidden = n !== steps.length;
    stepLabel.textContent = `Step ${n} of ${steps.length} — ${steps[n - 1]}`;
    stepCount.textContent = `${n}/${steps.length}`;
    progress.style.width = `${(n / steps.length) * 100}%`;
  }

  backBtn.addEventListener("click", () => showStep(Math.max(1, current - 1)));
  nextBtn.addEventListener("click", () => {
    if (current === 1 && !form.email.reportValidity()) return;
    showStep(Math.min(steps.length, current + 1));
  });
  // Enter in a text field should advance a step, not submit the form early.
  form.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && e.target.tagName !== "TEXTAREA" && current < steps.length) {
      e.preventDefault();
      nextBtn.click();
    }
  });

  function syncCurrency() {
    const cur = form.querySelector("[name=currency]:checked")?.value ?? "USD";
    form.querySelectorAll("[data-currency]").forEach((el) => (el.hidden = el.dataset.currency !== cur));
  }
  form.querySelector("#currency-group")?.addEventListener("change", () => {
    syncCurrency();
    ["fairPrice", "tooExpensive", "currentSpend"].forEach((name) => {
      form.querySelectorAll(`[name=${name}]`).forEach((i) => (i.checked = false));
    });
  });

  form.querySelector("#wouldpay-group")?.addEventListener("change", () => {
    const extra = form.querySelector("#pricing-extra");
    const val = form.querySelector("[name=wouldPay]:checked")?.value;
    extra.hidden = !(val === "Yes" || val === "Maybe, depending on price");
  });

  form.querySelectorAll("[data-max-select]").forEach((group) => {
    const max = Number(group.dataset.maxSelect);
    group.addEventListener("change", (e) => {
      if (group.querySelectorAll("input:checked").length > max) e.target.checked = false;
    });
  });

  form.querySelectorAll("[data-other-toggle]").forEach((input) => {
    const group = input.closest("[data-options]");
    const other = form.querySelector(`[name=${input.dataset.otherToggle}]`);
    group.addEventListener("change", () => {
      other.hidden = !input.checked;
      if (!input.checked) other.value = "";
    });
  });

  function buildWaitlistMessage(d) {
    const v = (name) => String(d.get(name) ?? "").trim();
    const multi = (name) => d.getAll(name).map(String).filter(Boolean);
    const role = v("role") === "Other" ? v("roleOther") || "Other" : v("role");
    const tools = multi("tools").map((t) => (t === "Other" ? v("toolsOther") || "Other" : t));
    const features = multi("features");
    const lines = [
      v("company") && `Company: ${v("company")}`,
      role && `What best describes them: ${role}`,
      v("currency") && `Currency: ${v("currency")}`,
      v("servers") && `Servers managed: ${v("servers")}`,
      v("teamSize") && `Team size: ${v("teamSize")}`,
      tools.length && `Current tools: ${tools.join(", ")}`,
      features.length && `Top features: ${features.join(", ")}`,
      v("howRun") && `How they'd run N-Ops: ${v("howRun")}`,
      v("wouldPay") && `Would pay for Managed: ${v("wouldPay")}`,
      v("fairPrice") && `Fair monthly price: ${v("fairPrice")}`,
      v("tooExpensive") && `Too-expensive monthly price: ${v("tooExpensive")}`,
      v("payPreference") && `Payment preference: ${v("payPreference")}`,
      v("buyerRole") && `Buyer role: ${v("buyerRole")}`,
      v("currentSpend") && `Current monthly spend: ${v("currentSpend")}`,
      v("topProblem") && `Top problem to solve: ${v("topProblem")}`,
      v("canContact") && `OK to contact for a call: ${v("canContact")}`,
    ].filter(Boolean);
    return `Waitlist signup\n\n${lines.join("\n")}`;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!form.email.reportValidity()) { showStep(1); return; }
    const d = new FormData(form);
    const token = String(d.get("cf-turnstile-response") ?? "");
    if (!token) { status.textContent = "Please complete the captcha first."; return; }
    const message = buildWaitlistMessage(d);
    submitBtn.disabled = true; status.textContent = "Sending…";
    try {
      const res = await fetch(form.dataset.url, {
        method: "POST",
        headers: { "content-type": "application/json", "x-cf-token": token },
        body: JSON.stringify({ name: d.get("name"), email: d.get("email"), message, send_to: form.dataset.to }),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      form.querySelector("#pricing-extra")?.setAttribute("hidden", "");
      form.querySelectorAll("[name=roleOther], [name=toolsOther]").forEach((i) => (i.hidden = true));
      syncCurrency();
      showStep(1);
      status.textContent = "Thanks, we'll be in touch.";
    } catch {
      status.textContent = "Something went wrong. Please try again.";
    } finally {
      submitBtn.disabled = false;
      window.turnstile?.reset(form.querySelector(".cf-turnstile"));
    }
  });

  showStep(1);
</script>
