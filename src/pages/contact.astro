---
import BaseLayout from "../layouts/BaseLayout.astro";
import ApiForm from "../components/ApiForm.astro";
const lbl = "font-mono text-[10.5px] tracking-[.14em] uppercase text-mute";
---
<BaseLayout title="Contact us — N-Ops" description="Questions about N-Ops, Managed Cloud or enterprise plans? Send us a message and the team will get back to you." path="/contact">
<section class="sec" aria-labelledby="ct-h">
  <div class="wrap grid grid-cols-12 gap-x-[var(--gut)] gap-y-10 items-start">
    <div class="col-span-5 max-bp2:col-span-12">
      <p class="eyebrow"><span class="bar"></span>Contact</p>
      <h1 id="ct-h" class="mt-5 text-[clamp(2.4rem,5vw,4.4rem)] leading-[.98] tracking-[-.05em]">Talk to a <span class="grad-t">real person.</span></h1>
      <p class="mt-6 max-w-[44ch] text-ink-2 text-[clamp(16px,1.3vw,18px)]">Questions about plans, limits, onboarding or enterprise SLAs? Tell us about your servers and team, and we will get back to you.</p>
      <div class="mt-8"><p class={lbl}>Website</p><a class="mt-1 block font-semibold hover:text-mint-ink" href="https://nops.app" rel="noopener">nops.app</a></div>
      <div class="mt-5"><p class={lbl}>Source</p><a class="mt-1 block font-semibold hover:text-mint-ink break-words" href="https://github.com/Neko-Nik-Org/N-Ops-Main-API" rel="noopener">github.com/Neko-Nik-Org/N-Ops-Main-API</a></div>
      <div class="mt-5"><p class={lbl}>Company</p><p class="mt-1 text-[15px]">N-Ops by Neko Nik, in partnership with YSPL (Yukthi Systems Private Limited).</p></div>
    </div>
    <div class="col-span-7 max-bp2:col-span-12 rounded-[22px] border border-line-2 bg-surface p-[clamp(22px,2.6vw,36px)]">
      <h2 class="text-[22px] font-semibold tracking-[-.03em]">Send us a message</h2>
      <p class="mt-3 text-mute text-[15px]">Please never include real secrets or credentials.</p>
      <ApiForm kind="contact" button="Send message" />
    </div>
  </div>
</section>
</BaseLayout>
