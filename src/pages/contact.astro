---
import BaseLayout from "../layouts/BaseLayout.astro";
import ApiForm from "../components/ApiForm.astro";
const row = "flex items-center gap-4 py-4 border-b border-line";
const k = "w-20 shrink-0 font-mono text-[11px] tracking-[.12em] uppercase text-mute";
const topics = ["Managed Cloud", "Enterprise & SLAs", "Self-hosting help", "Something else"];
---
<BaseLayout title="Contact N-Ops: Managed Cloud & Enterprise Questions" description="Questions about N-Ops, Managed Cloud or enterprise plans? Send us a message and the team will get back to you." path="/contact">
<section class="pt-[clamp(28px,4.5vw,64px)] pb-[clamp(64px,8vw,128px)]" aria-labelledby="ct-h">
  <div class="wrap grid grid-cols-12 gap-x-[var(--gut)] gap-y-10 items-start">
    <div class="col-span-4 max-bp2:col-span-12 bp2:sticky bp2:top-[calc(var(--nav)+24px)]">
      <p class="eyebrow"><span class="bar"></span>Contact</p>
      <h1 id="ct-h" class="mt-5 text-[clamp(2.4rem,4.4vw,3.9rem)] leading-[.95] tracking-[-.05em]">Talk to a <span class="grad-t">real person.</span></h1>
      <p class="mt-4 max-w-[38ch] text-ink-2 text-[clamp(16px,1.25vw,18px)]">Questions about plans, limits, onboarding or enterprise SLAs? Tell us about your servers and team, and we'll get back to you.</p>
      <ul class="mt-9 border-t-[1.5px] border-ink text-[15px]">
        <li class={row}><span class={k}>Website</span><a class="font-medium hover:text-mint-ink transition-colors" href="https://nops.app" rel="noopener">nops.app</a></li>
        <li class={row}><span class={k}>Source</span><a class="font-medium hover:text-mint-ink transition-colors break-all" href="https://github.com/Neko-Nik-Org/N-Ops-Main-API" rel="noopener">Neko-Nik-Org/N-Ops-Main-API</a></li>
        <li class={row}><span class={k}>Company</span><span class="text-ink-2">Neko Nik, in partnership with YSPL (Yukthi Systems Private Limited)</span></li>
      </ul>
      <a href="/waitlist" class="group mt-7 flex items-center gap-3.5 rounded-2xl border border-line-2 bg-surface p-4 pr-3 transition-colors hover:border-ink">
        <span class="wl-dot ml-1" aria-hidden="true"></span>
        <span class="flex-1 leading-tight"><span class="block text-[15px] font-semibold">Just want early access?</span><span class="block mt-0.5 text-[13.5px] text-mute">Join the Managed Cloud waitlist instead.</span></span>
        <span class="grid place-items-center w-9 h-9 rounded-[11px] bg-mint text-ink-f transition-transform group-hover:translate-x-0.5" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
    <div class="col-span-8 bp2:col-start-5 max-bp2:col-span-12">
      <div class="rounded-[clamp(20px,2vw,26px)] border border-line-2 bg-surface shadow-[0_30px_70px_-50px_rgba(11,17,24,.5)] p-[clamp(20px,3vw,40px)]">
        <h2 class="max-w-none text-[clamp(1.45rem,2.2vw,1.9rem)] leading-[1.1] tracking-[-.035em]">Send us a message</h2>
        <p class="mt-2 mb-8 text-[15px] text-mute">A few lines is plenty. The team reads every message.</p>
        <ApiForm kind="contact" button="Send message" topics={topics} />
      </div>
    </div>
  </div>
</section>
</BaseLayout>
