---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { InferGetStaticPropsType } from "astro";
import { areas } from "../../data/product.js";

export function getStaticPaths() {
  return areas.map((a, i) => ({
    params: { slug: a.slug },
    props: { a, prev: areas[(i + areas.length - 1) % areas.length], next: areas[(i + 1) % areas.length] },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { a, prev, next } = Astro.props as Props;
const [mTitle, mMeta, mRows] = a.mock;
const GH = "https://github.com/Neko-Nik-Org/N-Ops-Main-API";
const total = String(areas.length).padStart(2, "0");
// status words in the example screen get a coloured dot, so the mock reads like a live UI
const tone = (v: string) => /offline|denied|failed|off\b/i.test(v) ? "bad" : /online|\bon\b|ok|running|up\b|healthy|approved|active/i.test(v) ? "good" : "";
const pad = (n: number) => String(n).padStart(2, "0");
const neighbours = [["prev", prev], ["next", next]] as const;
---
<BaseLayout title={`${a.title} — N-Ops Control Plane`} description={a.lead} path={`/product/${a.slug}`}>

<!-- hero -->
<section class="relative pt-[clamp(24px,4vw,56px)] pb-[clamp(48px,7vw,104px)]" aria-labelledby="pr-h">
  <div class="wrap">
    <div class="flex items-center justify-between gap-4 font-mono text-[11.5px] tracking-[.08em] text-mute">
      <a href="/#chapters" class="inline-flex items-center gap-2 hover:text-ink transition-colors"><svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"/></svg>All modules</a>
      <span>Module {a.n} / {total}</span>
    </div>
    <div class="mt-[clamp(28px,4vw,56px)] grid grid-cols-12 gap-x-[var(--gut)] gap-y-12 items-center">
      <div class="col-span-6 max-bp2:col-span-12">
        <p class="eyebrow"><span class="bar"></span>{a.n} &middot; Product</p>
        <h1 id="pr-h" class="mt-5 text-[clamp(2.6rem,5.6vw,5.2rem)] leading-[.95] tracking-[-.05em] text-balance">{a.title}</h1>
        <p class="mt-6 max-w-[46ch] text-ink-2 text-[clamp(17px,1.35vw,20px)] leading-[1.5]">{a.lead}</p>
        <ul class="mt-7 flex flex-wrap gap-2" aria-label="Highlights" data-rv>
          {a.tags.map(t => <li class="rounded-full border border-line-2 bg-surface px-3 py-1.5 font-mono text-[11.5px] text-ink-2">{t}</li>)}
        </ul>
        <div class="mt-9 flex flex-wrap gap-2.5" data-rv>
          <a class="btn btn-dark max-bp4:grow max-bp4:justify-center" href={GH} rel="noopener"><svg aria-hidden="true"><use href="#i-gh"/></svg>Get it on GitHub</a>
          <a class="btn btn-line max-bp4:grow max-bp4:justify-center" href="/waitlist">Join the waitlist</a>
        </div>
      </div>
      <div class="col-span-6 max-bp2:col-span-12" data-rv="scale">
        <div class="relative rounded-[clamp(20px,2.2vw,28px)] border border-line-2 bg-bg-2 p-[clamp(14px,2.4vw,32px)] overflow-hidden">
          <div class="pointer-events-none absolute -right-1/4 -top-1/3 w-3/4 aspect-square rounded-full bg-[radial-gradient(closest-side,rgba(138,124,255,.18),transparent)]" aria-hidden="true"></div>
          <div class="pointer-events-none absolute -left-1/4 -bottom-1/3 w-3/4 aspect-square rounded-full bg-[radial-gradient(closest-side,rgba(76,242,192,.16),transparent)]" aria-hidden="true"></div>
          <div class="rv-rows relative rounded-2xl border border-line-2 bg-surface overflow-hidden font-mono text-[12px] leading-[1.4] shadow-[0_24px_50px_-30px_rgba(11,17,24,.45)]" role="img" aria-label={`${a.title}: example screen`}>
            <div class="flex items-center gap-2 px-4 py-3 border-b border-line-2 text-mute" aria-hidden="true"><span class="flex gap-1.5"><i class="w-2 h-2 rounded-full bg-line-2"></i><i class="w-2 h-2 rounded-full bg-line-2"></i><i class="w-2 h-2 rounded-full bg-line-2"></i></span><span class="ml-1 text-ink">{mTitle}</span><span class="ml-auto">{mMeta}</span></div>
            {mRows.map(([k, v]) => (
              <div class="flex items-center justify-between gap-3 px-4 py-3.5 border-t border-line first:border-t-0" data-row aria-hidden="true">
                <span class="text-mute">{k}</span>
                <span class="inline-flex items-center gap-2 text-right text-ink">
                  {tone(v) && <i class={`w-1.5 h-1.5 rounded-full ${tone(v) === "bad" ? "bg-red" : "bg-mint-ink"}`}></i>}{v}
                </span>
              </div>
            ))}
          </div>
          <p class="relative mt-3 font-mono text-[10.5px] tracking-[.08em] uppercase text-mute">Example screen &middot; concept UI</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- what you get -->
<section class="sec alt" aria-labelledby="wg-h">
  <div class="wrap grid grid-cols-12 gap-x-[var(--gut)] gap-y-10">
    <div class="col-span-4 max-bp2:col-span-12">
      <div class="bp2:sticky bp2:top-[calc(var(--nav)+32px)]">
        <p class="eyebrow"><span class="bar"></span>What you get</p>
        <h2 id="wg-h" class="mt-5 max-w-[14ch] text-[clamp(2rem,3.6vw,3.2rem)] leading-[1] tracking-[-.045em]">{a.title}, in detail.</h2>
      </div>
    </div>
    <ol class="col-span-8 max-bp2:col-span-12 grid grid-cols-2 max-bp3:grid-cols-1 gap-x-[var(--gut)] border-t-[1.5px] border-ink">
      {a.points.map((p, j) => (
        <li class="flex gap-4 border-b border-line py-5 text-[16px] leading-[1.5]">
          <span class="pt-[3px] font-mono text-[11px] tracking-[.06em] text-mint-ink">{pad(j + 1)}</span><span>{p}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- how it works: always three -->
<section class="sec" aria-labelledby="hw-h">
  <div class="wrap">
    <p class="eyebrow"><span class="bar"></span>How it works</p>
    <h2 id="hw-h" class="mt-5 text-[clamp(2rem,3.6vw,3.2rem)] leading-[1] tracking-[-.045em]">Built to be trusted.</h2>
    <div class="mt-10 grid grid-cols-3 max-bp2:grid-cols-1 gap-[var(--gut)]">
      {a.details.map(([t, d], j) => (
        <div class="group relative overflow-hidden rounded-2xl border border-line-2 bg-surface p-[clamp(22px,2.2vw,30px)] transition-colors hover:border-ink/40">
          <span class="absolute inset-x-0 top-0 h-[3px] origin-left scale-x-0 transition-transform duration-500 ease-std group-hover:scale-x-100 [background:var(--grad)]" aria-hidden="true"></span>
          <p class="font-mono text-[11px] tracking-[.14em] text-mint-ink">{pad(j + 1)}</p>
          <h3 class="mt-6 text-[clamp(1.25rem,1.6vw,1.5rem)] font-semibold leading-[1.15] tracking-[-.03em]">{t}</h3>
          <p class="mt-3 text-[15px] text-mute leading-[1.6]">{d}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 flex gap-2.5 items-baseline text-[14.5px] text-mute" data-rv><span class="bar"></span>N-Ops is in active development. This page describes the product direction, so check GitHub for what each release includes.</p>
  </div>
</section>

<!-- deeper sections: heading on the left, a two-column list on the right (any item count reads cleanly) -->
{a.sections.map(([title, intro, items], k) => (
<section class={k === 0 ? "pt-0 pb-[clamp(32px,4vw,64px)] -mt-[clamp(24px,3vw,56px)]" : "py-[clamp(32px,4vw,64px)]"} aria-label={title}>
  <div class="wrap">
    <div class="grid grid-cols-12 gap-x-[var(--gut)] gap-y-8 border-t border-line pt-[clamp(32px,4vw,56px)]">
      <div class="col-span-4 max-bp2:col-span-12">
        <div class="bp2:sticky bp2:top-[calc(var(--nav)+32px)]">
          <p class="font-mono text-[11px] tracking-[.14em] uppercase text-mute">{a.n}.{k + 1}</p>
          <h2 class="mt-4 max-w-[16ch] text-[clamp(1.7rem,2.8vw,2.5rem)] leading-[1.02] tracking-[-.04em]">{title}</h2>
          <p class="mt-3 max-w-[34ch] text-mute text-[15.5px]">{intro}</p>
        </div>
      </div>
      <dl class="col-span-8 max-bp2:col-span-12 grid grid-cols-2 max-bp3:grid-cols-1 gap-x-[clamp(20px,3vw,48px)]">
        {items.map(([kk, v]) => (
          <div class="border-t border-line py-5 first:border-t-0 bp3:[&:nth-child(2)]:border-t-0">
            <dt class="flex items-center gap-2.5 text-[17px] font-semibold tracking-[-.02em]"><span class="bar !text-[15px]"></span>{kk}</dt>
            <dd class="mt-2 text-[15px] text-mute leading-[1.6]">{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
))}

<!-- managed cloud waitlist -->
<section class="py-[clamp(24px,4vw,56px)]" aria-labelledby="pw-h">
  <div class="wrap">
    <div class="on-dark relative overflow-hidden rounded-[clamp(20px,2.2vw,30px)] bg-t-bg text-t-ink p-[clamp(28px,4vw,56px)] grid grid-cols-12 gap-x-[var(--gut)] gap-y-6 items-center" data-rv="scale" data-wl-hide>
      <div class="pointer-events-none absolute -right-[10%] -top-[60%] w-[55%] aspect-square rounded-full bg-[radial-gradient(closest-side,rgba(138,124,255,.26),transparent)]" aria-hidden="true"></div>
      <div class="relative col-span-8 max-bp2:col-span-12">
        <p class="inline-flex items-center gap-3 font-mono text-[11px] tracking-[.14em] uppercase text-t-mute"><span class="wl-dot" aria-hidden="true"></span>Managed Cloud &middot; early access</p>
        <h2 id="pw-h" class="mt-4 max-w-[22ch] text-[clamp(1.8rem,3.4vw,3rem)] leading-[1] tracking-[-.045em]">Rather we ran N-Ops for you? <span class="grad-t">Join the waitlist.</span></h2>
      </div>
      <div class="relative col-span-4 max-bp2:col-span-12 flex bp2:justify-end">
        <a class="btn btn-mint group" href="/waitlist">Join the waitlist<svg class="transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
      </div>
    </div>
  </div>
</section>

<!-- previous / next module -->
<section class="pt-[clamp(24px,4vw,56px)] pb-[clamp(56px,7vw,112px)]" aria-label="More modules">
  <nav class="wrap grid grid-cols-2 max-bp3:grid-cols-1 gap-[var(--gut)]" aria-label="Modules">
    {neighbours.map(([dir, m]) => (
      <a href={`/product/${m.slug}`} class={`group relative overflow-hidden rounded-2xl border border-line-2 bg-surface p-[clamp(20px,2.4vw,32px)] transition-colors hover:border-ink ${dir === "next" ? "bp3:text-right" : ""}`}>
        <span class={`absolute bottom-0 h-[3px] w-full scale-x-0 transition-transform duration-500 ease-std group-hover:scale-x-100 [background:var(--grad)] ${dir === "next" ? "right-0 origin-right" : "left-0 origin-left"}`} aria-hidden="true"></span>
        <p class={`flex items-center gap-2 font-mono text-[11px] tracking-[.14em] uppercase text-mute ${dir === "next" ? "bp3:justify-end" : ""}`}>{dir === "prev" ? <>&larr; Previous</> : <>Next &rarr;</>}<span class="opacity-60">&middot; {m.n}</span></p>
        <p class="mt-4 text-[clamp(1.3rem,2vw,1.75rem)] font-semibold leading-[1.1] tracking-[-.03em]">{m.title}</p>
        <p class="mt-2 text-[14.5px] text-mute">{m.short}</p>
      </a>
    ))}
  </nav>
</section>
</BaseLayout>
